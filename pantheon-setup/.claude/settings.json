{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git push --all:*)",
      "Bash(git push --mirror:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git branch -D:*)",
      "Bash(terminus:*)",
      "Bash(wp:*)",
      "Read(~/.ssh/**)",
      "Read(~/.wp-hayley-credential.xml)",
      "Edit(~/.ssh/**)",
      "Edit(~/.wp-hayley-credential.xml)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git commit:*)",
      "Bash(curl:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File .claude/scripts/push-page.ps1:*)",
      "WebFetch"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current)",
      "Bash(powershell -ExecutionPolicy Bypass -File .claude/scripts/pull-page.ps1:*)"
    ]
  }
}
